<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio Saya</title>
</head>

<body>

    <!-- SECTION 1: MENU -->
    <table width="100%" border="1" cellpadding="15">
        <tr>
            <td width="20%">
                <b>MY PORTFOLIO</b>
            </td>

            <td align="right">
                <a href="#home">Home</a> |
                <a href="#biodata">Biodata</a> |
                <a href="#portfolio">Portfolio</a> |
                <a href="#contact">Contact</a>
            </td>
        </tr>
    </table>


    <br><br>


    <!-- SECTION 2: JUDUL KIRI + GAMBAR KANAN -->
    <table width="100%" border="1" cellpadding="30">
        <tr>
            <!-- Bagian kiri -->
            <td width="60%" valign="middle">
                <h1>Halo, Saya Muhammad</h1>

                <h2>Web Developer & Digital Creator</h2>

                <p>
                    Saya adalah seseorang yang tertarik dengan dunia teknologi,
                    website, digital marketing, dan pengembangan bisnis.
                </p>

                <p>
                    <a href="#portfolio">Lihat Portfolio Saya</a>
                </p>
            </td>

            <!-- Bagian kanan -->
            <td width="40%" align="center">
                <img 
                    src="https://via.placeholder.com/300"
                    alt="Foto Profil"
                    width="300"
                >
            </td>
        </tr>
    </table>


    <br><br>


    <!-- SECTION 3: BIODATA -->
    <table width="100%" border="1" cellpadding="20" id="biodata">
        <tr>
            <td colspan="2" align="center">
                <h2>Biodata Saya</h2>
                <p>Kenali saya lebih dekat</p>
            </td>
        </tr>

        <tr>
            <td width="50%">
                <h3>Data Diri</h3>

                <table width="100%" border="1" cellpadding="10">
                    <tr>
                        <td><b>Nama</b></td>
                        <td>Muhammad</td>
                    </tr>

                    <tr>
                        <td><b>Profesi</b></td>
                        <td>Web Developer</td>
                    </tr>

                    <tr>
                        <td><b>Pendidikan</b></td>
                        <td>Sarjana</td>
                    </tr>

                    <tr>
                        <td><b>Lokasi</b></td>
                        <td>Indonesia</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                <h3>Keahlian</h3>

                <table width="100%" border="1" cellpadding="10">
                    <tr>
                        <td>HTML</td>
                    </tr>

                    <tr>
                        <td>Website Development</td>
                    </tr>

                    <tr>
                        <td>Digital Marketing</td>
                    </tr>

                    <tr>
                        <td>AI & Automation</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>


    <br><br>


    <!-- SECTION 4: PORTFOLIO -->
    <table width="100%" border="1" cellpadding="20" id="portfolio">
        <tr>
            <td colspan="3" align="center">
                <h2>Portfolio Saya</h2>
                <p>Beberapa project yang pernah saya kerjakan</p>
            </td>
        </tr>

        <tr>
            <!-- Portfolio 1 -->
            <td width="33%" align="center">
                <img 
                    src="https://via.placeholder.com/250x150"
                    alt="Project Website"
                    width="250"
                >

                <h3>Website Company</h3>

                <p>
                    Website profesional untuk kebutuhan bisnis.
                </p>

                <a href="#">Lihat Project</a>
            </td>

            <!-- Portfolio 2 -->
            <td width="33%" align="center">
                <img 
                    src="https://via.placeholder.com/250x150"
                    alt="Landing Page"
                    width="250"
                >

                <h3>Landing Page</h3>

                <p>
                    Landing page untuk meningkatkan penjualan.
                </p>

                <a href="#">Lihat Project</a>
            </td>

            <!-- Portfolio 3 -->
            <td width="33%" align="center">
                <img 
                    src="https://via.placeholder.com/250x150"
                    alt="Website Portfolio"
                    width="250"
                >

                <h3>Personal Portfolio</h3>

                <p>
                    Website portfolio untuk personal branding.
                </p>

                <a href="#">Lihat Project</a>
            </td>
        </tr>
    </table>


    <br><br>


    <!-- CONTACT -->
    <table width="100%" border="1" cellpadding="20" id="contact">
        <tr>
            <td align="center">
                <h2>Hubungi Saya</h2>

                <p>
                    Email: example@gmail.com
                </p>

                <p>
                    WhatsApp: 08xxxxxxxxxx
                </p>
            </td>
        </tr>
    </table>


    <br>

    <!-- FOOTER -->
    <table width="100%" border="1" cellpadding="15">
        <tr>
            <td align="center">
                © 2026 My Portfolio
            </td>
        </tr>
    </table>

</body>
</html>